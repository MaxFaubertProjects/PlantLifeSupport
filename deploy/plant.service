[Unit]
Description=Plant Life Support — control loop + dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maxpi
Group=maxpi
WorkingDirectory=/home/maxpi/PlantLifeSupport
ExecStart=/home/maxpi/PlantLifeSupport/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
