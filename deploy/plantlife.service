# Plant Life Support — systemd unit (control loop + dashboard).
#
# Install:
#   sudo cp deploy/plantlife.service /etc/systemd/system/plantlife.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now plantlife
#
# Deploy updates: `git pull` on the Pi; re-copy this file only when it changes.

[Unit]
Description=Plant Life Support — AI plant monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maxpi
Group=maxpi
WorkingDirectory=/home/maxpi/PlantLifeSupport
# Optional secrets (e.g. PLANT_CONTROL_PASSWORD for the public dashboard).
# The leading '-' makes it optional so the service still starts without it.
EnvironmentFile=-/home/maxpi/PlantLifeSupport/.env
ExecStart=/home/maxpi/PlantLifeSupport/.venv/bin/python main.py
Restart=on-failure
RestartSec=10

# Give Ollama time to be reachable before the first AI cycle
# (the control loop has its own timeout/fallback, so this is just a cushion)
ExecStartPre=/bin/sleep 5

# Allow uhubctl to run without a password prompt.
# Make sure /etc/sudoers.d/uhubctl contains:
#   maxpi ALL=(ALL) NOPASSWD: /usr/sbin/uhubctl

StandardOutput=journal
StandardError=journal
SyslogIdentifier=plantlife

[Install]
WantedBy=multi-user.target
